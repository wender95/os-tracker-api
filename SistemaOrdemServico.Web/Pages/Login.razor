@page "/login"
@inject HttpClient Http
@inject CustomAuthStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="container py-5 d-flex justify-content-center">
    <div class="card border-0 shadow-lg rounded-4 p-4" style="max-width: 400px; width: 100%;">
        <div class="text-center mb-4">
            <h4 class="fw-bold" style="color: #0b2f6b;">🔑 Acesso ao Sistema</h4>
            <span class="text-muted small">Digite seu nome de usuário e senha</span>
        </div>

        @if (!string.IsNullOrEmpty(mensagemErro))
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3">
                ❌ @mensagemErro
            </div>
        }

        <EditForm Model="@loginModel" OnValidSubmit="@RealizarLogin">
            <div class="mb-3">
                <label class="form-label text-muted small fw-bold">NOME DE USUÁRIO</label>
                <InputText class="form-control form-control-lg fs-6" @bind-Value="loginModel.Usuario" placeholder="Ex: admin" />
            </div>

            <div class="mb-4">
                <label class="form-label text-muted small fw-bold">SENHA</label>
                <InputText type="password" class="form-control form-control-lg fs-6" @bind-Value="loginModel.Senha" placeholder="******" />
            </div>

            <button type="submit" class="btn text-white fw-bold w-100 py-2 rounded-3" style="background-color: #0b2f6b;" disabled="@processando">
                @(processando ? "Entrando..." : "Entrar no Sistema")
            </button>
        </EditForm>
    </div>
</div>

@code {
    private LoginModel loginModel = new();
    private string mensagemErro = string.Empty;
    private bool processando = false;

    private async Task RealizarLogin()
    {
        mensagemErro = string.Empty;
        processando = true;

        var userDigitado = loginModel.Usuario?.Trim() ?? "";
        var senhaDigitada = loginModel.Senha?.Trim() ?? "";

        // Fallback imediato de emergência para admin
        if (userDigitado.Equals("admin", StringComparison.OrdinalIgnoreCase) && senhaDigitada == "123456")
        {
            await AuthStateProvider.MarkUserAsAuthenticated("TOKEN_ADMIN_FALLBACK", "admin", "Criacao", "Administrador");
            Nav.NavigateTo("");
            return;
        }

        try
        {
            var res = await Http.PostAsJsonAsync("api/Auth/login", loginModel);
            if (res.IsSuccessStatusCode)
            {
                var result = await res.Content.ReadFromJsonAsync<LoginResponse>();
                if (result != null)
                {
                    await AuthStateProvider.MarkUserAsAuthenticated(result.Token, result.Usuario, result.Setor, result.Role);
                    Nav.NavigateTo("");
                }
            }
            else
            {
                mensagemErro = "Usuário ou senha incorretos.";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro de conexão: {ex.Message}";
        }
        finally
        {
            processando = false;
        }
    }

    public class LoginModel
    {
        public string Usuario { get; set; } = string.Empty;
        public string Senha { get; set; } = string.Empty;
    }

    public class LoginResponse
    {
        public string Token { get; set; } = string.Empty;
        public string Usuario { get; set; } = string.Empty;
        public string Setor { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }
}